# ------------------------------------------------------------------
# Tracking env vars. Set in Vercel, never committed. All optional for a
# local build; tracking runs only on a production deploy (or with the
# preview opt-in below).
# ------------------------------------------------------------------

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Overrides the site's
# own property, G-8Z94ST45J6 in next.config.ts. gtag.js loads only where
# tracking runs, so a preview deploy never sends hits to the real property.
NEXT_PUBLIC_GA4_ID=

# MEGA managed site id (UUID). Set by the provisioning bot / controller.
# Sent as `mega_site_id` on every PostHog event so the shared MEGA Websites
# project can split traffic per site. Missing or not a UUID: tracking still
# runs, but the property is omitted and go-live QA fails the site.
# (Lead routing uses its own ids in src/lib/leadConfig.ts, not this.)
NEXT_PUBLIC_MEGA_SITE_ID=

# PostHog loads through the /ingest reverse proxy into the shared MEGA
# Websites project. The project key and host are constants in
# src/lib/tracking/destination.ts; NEXT_PUBLIC_POSTHOG_KEY and
# NEXT_PUBLIC_POSTHOG_HOST are no longer read, so do not set them.
# next.config.ts derives the browser's NEXT_PUBLIC_VERCEL_ENV from VERCEL_ENV,
# which Vercel sets on every build; anything but "production" is off, and the
# build log says so.

# Set to 1 to run tracking (PostHog and GA4) outside production, for local
# verification only.
NEXT_PUBLIC_MEGA_TRACKING_PREVIEW=

# Set to 1 to turn all PostHog and GA4 tracking off everywhere, even in
# production. Wins over NEXT_PUBLIC_MEGA_TRACKING_PREVIEW.
NEXT_PUBLIC_MEGA_TRACKING_DISABLED=
